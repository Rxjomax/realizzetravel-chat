{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/settings/whatsapp/qr/generate",
      "destination": "/api/settings/whatsapp/qr/generate"
    },
    {
      "source": "/api/settings/whatsapp/evolution/reset",
      "destination": "/api/settings/whatsapp/evolution/reset"
    },
    {
      "source": "/api/settings/whatsapp/status",
      "destination": "/api/settings/whatsapp/status"
    },
    {
      "source": "/api/settings/whatsapp/config",
      "destination": "/api/settings/whatsapp/config"
    },
    {
      "source": "/api/webhooks/whatsapp",
      "destination": "/api/webhooks/whatsapp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
