{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    },
    "api/webhooks/whatsapp.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/webhooks/whatsapp",
      "destination": "/api/webhooks/whatsapp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
